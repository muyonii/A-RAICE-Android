<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    tools:context=".ui.admin.ReportsFragment">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/reportsScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/nav_clearance"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding_H"
                android:paddingEnd="@dimen/screen_padding_H">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="64dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/spacegrotesk_bold"
                    android:text="@string/Reports_Title"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/manrope_regular"
                    android:text="@string/Reports_Subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <!-- Generate Report Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenGenerateReport"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/Generate_Report_Button"
                    android:textColor="@color/text_on_primary"
                    android:textSize="14sp"
                    app:backgroundTint="@color/primary_bright"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/report"
                    app:iconGravity="textStart"
                    app:iconTint="@color/text_on_primary" />

                <TextView
                    android:id="@+id/tvReportsHistoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/spacegrotesk_bold"
                    android:text="@string/Reports_History_Title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <ProgressBar
                    android:id="@+id/pbReportsLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:indeterminateTint="@color/gold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvNoReports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:fontFamily="@font/manrope_regular"
                    android:text="@string/Report_No_Reports"
                    android:textAlignment="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include
        android:id="@+id/topBar"
        layout="@layout/view_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</FrameLayout>